    "location": [
        {"name": "Alta Guia", "text": "37 Bagong Calzada Street,\nUsusan, Taguig City, 1632", "text2": "Landmarks: Garden of Memories / Ususan Barangay Hall / Villa Rosalinda / Lake View"},
        {"name": "Getting there:", "text": "If you're not planning to use your vehicle, we recommend taking a taxi or ride-hailing services such as Grab and Angkas to get to Alta Guia for your convenience. However, if you still prefer commuting, please refer to the guide below."},
        {"name": "Grab Pin Location:", "text": "Alta Guia (24, Bagong Calzada Street, Ususan, Taguig City)"},
        {"name": "Angkas Pin Location:", "text": "Alta Guia (Taguig, Metro Manila)"},
        {"name": "Via commute:", "text": "If you're coming from EDSA, take the MRT to Guadalupe Station. Go to the Guadalupe Terminal and take the jeepney going to Pateros. Once you arrive in Pateros, walk towards Mercury Drug (B.Morcilla cor. M.Almeda). From there, take the jeepney going to B.Bayan/Bicutan and get off at Ususan (tell the driver to drop you off near Ususan Barangay Hall). From there, ride a trike going to Alta Guia."}
